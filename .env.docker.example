# Copy to .env.docker (git-ignored) and fill in. Used by docker-compose.yml.
PUBLIC_URL=http://localhost:8080
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

NODE_ENV=production
# Generate: openssl rand -hex 48 (each)
JWT_SECRET=
JWT_REFRESH_SECRET=
# Generate: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# Production needs a real SMS provider (console is refused).
OTP_PROVIDER=msg91
OTP_API_KEY=
OTP_TEMPLATE_ID=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
PUSH_PROVIDER=none
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
API_DOCS=off

# First super admin (used by the seed only)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
