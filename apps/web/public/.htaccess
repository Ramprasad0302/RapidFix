# RapidFix website on Apache/LiteSpeed (Hostinger shared hosting)
Options -MultiViews
AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType text/javascript .js

RewriteEngine On
RewriteBase /

# Always HTTPS (phones need it for location and notifications)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Real files and folders are served as they are…
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# …every app address (/bookings/123, /admin, …) loads the app.
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Always fetch the newest app shell, settings and service worker
  <FilesMatch "^(index\.html|config\.js|sw\.js|manifest\.webmanifest|offline\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
