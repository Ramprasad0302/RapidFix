# Same-origin: the Vite dev server (and nginx in production) forward these to the API.
VITE_API_URL=/api/v1
VITE_SOCKET_URL=
# Optional: enables live maps (tracking, choose-on-map)
VITE_GOOGLE_MAPS_API_KEY=
# Optional: web push when the app is closed (Firebase project → Cloud Messaging → Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Optional; defaults to <project-id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
