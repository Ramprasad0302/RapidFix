# ─── FIXORA backend (copy to backend/.env) ───────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/fixora

# Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# console = print OTP to the API log (development only). msg91 / twilio in production.
OTP_PROVIDER=console
OTP_API_KEY=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

GOOGLE_MAPS_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# local = backend/uploads. s3 = any S3-compatible store.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
UPLOAD_MAX_MB=5

TAX_PERCENT=18
ASSIGNMENT_REQUEST_TIMEOUT_SECONDS=30

# ─── Frontends (apps/*/.env) ─────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_GOOGLE_MAPS_API_KEY=
VITE_RAZORPAY_KEY_ID=
