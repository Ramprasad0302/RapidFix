# ─── RapidFix backend (copy to backend/.env) ───────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/fixora
# Tests always use a local database; set this when DATABASE_URL points at a hosted server
TEST_DATABASE_URL=

# Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# console = print OTP to the API log (development only). An SMS provider must be
# implemented in backend/src/services/otp before production (console is rejected there).
OTP_PROVIDER=console
# msg91: OTP_API_KEY = MSG91 auth key, OTP_TEMPLATE_ID = DLT flow template containing ##otp##
# firebase: Firebase phone auth in the app — set FIREBASE_PROJECT_ID below and the VITE_FIREBASE_* web keys
OTP_API_KEY=
OTP_TEMPLATE_ID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_HOUR=5

GOOGLE_MAPS_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# local = backend/uploads. s3 = any S3-compatible store.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
UPLOAD_MAX_MB=5
# Relative to the backend folder
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=uploads-private

# AES-256-GCM key (64 hex chars) for bank account numbers. Generate: openssl rand -hex 32
DATA_ENCRYPTION_KEY=
# none = in-app + socket only; fcm = Firebase Cloud Messaging push (needs FIREBASE_*)
PUSH_PROVIDER=none
# Public URL of the web app (used in payment prefill / links)
WEB_APP_URL=http://localhost:5173

# Swagger UI at /api/docs/ — auto = on except in production
API_DOCS=auto

TAX_PERCENT=18
ASSIGNMENT_REQUEST_TIMEOUT_SECONDS=30

# ─── Web app (apps/web/.env) ─────────────────────────────────────────────
# Same-origin: the Vite dev server (and nginx in production) forward these to the API.
VITE_API_URL=/api/v1
VITE_SOCKET_URL=
# Optional: enables live maps (tracking, choose-on-map)
VITE_GOOGLE_MAPS_API_KEY=
# Optional: web push when the app is closed (Firebase project → Cloud Messaging → Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Optional; defaults to <project-id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
